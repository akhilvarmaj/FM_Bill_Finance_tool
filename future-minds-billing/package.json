{
  "name": "future-minds-billing",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "node ../scripts/generate-prisma.mjs && next dev -p 3000 -H 0.0.0.0",
    "build": "node ../scripts/generate-prisma.mjs && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node ../scripts/generate-prisma.mjs",
    "db:migrate": "tsx ../scripts/migrate.ts",
    "db:admin": "tsx ../scripts/bootstrap-admin.ts",
    "worker": "node --conditions=react-server --import tsx ../scripts/worker.ts",
    "jobs:run": "node --conditions=react-server --import tsx ../scripts/worker.ts --once"
  }
}
